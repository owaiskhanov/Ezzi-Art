{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A frame customization order containing image and configuration settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "config": { "type": "string", "description": "Stringified JSON of the configuration object" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "status", "config", "imageUrl", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Stores user orders"
    }
  }
}
